# Local development defaults for `docker-compose.dev.yml`. Every value here
# is a dev-only default — nothing here is a real secret, and this file is
# safe to commit as-is (it's still gitignored as `.env*` would be, but the
# *.development / *.example* filenames are the checked-in templates).
#
# DATABASE_URL MUST point at the least-privilege `pulsar_app` role created by
# scripts/db/init-roles.sh — NEVER at the Postgres bootstrap superuser
# (`postgres`/`initdb`). See docs/security-design.md for why this is a
# merge-blocking rule in this repo, not a style preference.

BIND_ADDR=0.0.0.0:8080

DATABASE_URL=postgres://pulsar_app:changeme@localhost:5432/pulsar_core
DATABASE_MAX_CONNECTIONS=10

REDIS_URL=redis://localhost:6379