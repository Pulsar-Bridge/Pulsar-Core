# Copy to .env and fill in. Every value here is an example / dev default —
# nothing here is a real secret.
#
# DATABASE_URL MUST point at the least-privilege `pulsar_app` role created by
# scripts/db/init-roles.sh — NEVER at the Postgres bootstrap superuser
# (`postgres`/`initdb`). See docs/security-design.md for why this is a
# merge-blocking rule in this repo, not a style preference.

BIND_ADDR=0.0.0.0:8080

DATABASE_URL=postgres://pulsar_app:changeme@localhost:5432/pulsar_core
DATABASE_MAX_CONNECTIONS=10

REDIS_URL=redis://localhost:6379

# How long an X-Idempotency-Key claim is held. Matches the 24h Anchor
# Platform retry window this relay is built against.
IDEMPOTENCY_TTL_SECONDS=86400

HORIZON_BASE_URL=https://horizon-testnet.stellar.org
HORIZON_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
HORIZON_CIRCUIT_BREAKER_RESET_AFTER_SECONDS=30