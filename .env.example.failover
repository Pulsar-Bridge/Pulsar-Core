# Template for `docker-compose.failover.yml`, where DATABASE_URL points at a
# read/write-promotable replica rather than the primary. Every value here is
# an example / dev default — nothing here is a real secret.
#
# DATABASE_URL MUST point at the least-privilege `pulsar_app` role created by
# scripts/db/init-roles.sh — NEVER at the Postgres bootstrap superuser
# (`postgres`/`initdb`), on the primary OR the replica. See
# docs/security-design.md for why this is a merge-blocking rule in this repo,
# not a style preference.

BIND_ADDR=0.0.0.0:8080