# Template only. Real production values are injected by the deployment
# platform's secret manager at deploy time — this file must never contain a
# live credential. Every `changeme*`/`REPLACE_*` value below is a placeholder
# to be overridden by that injection, not a default to ship with.
#
# DATABASE_URL MUST point at the least-privilege `pulsar_app` role — NEVER at
# the Postgres bootstrap superuser (`postgres`/`initdb`). This is exactly the
# failure mode described in docs/security-design.md: every prior `.env*` file
# in this repo's history connected as the bootstrap superuser, which silently
# bypasses Row-Level Security regardless of how correct the policies are.

BIND_ADDR=0.0.0.0:8080

DATABASE_URL=postgres://pulsar_app:REPLACE_AT_DEPLOY@REPLACE_AT_DEPLOY:5432/pulsar_core
DATABASE_MAX_CONNECTIONS=20

REDIS_URL=redis://REPLACE_AT_DEPLOY:6379

IDEMPOTENCY_TTL_SECONDS=86400

HORIZON_BASE_URL=https://horizon.stellar.org
HORIZON_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
HORIZON_CIRCUIT_BREAKER_RESET_AFTER_SECONDS=30

CONTRACT_RPC_URL=REPLACE_AT_DEPLOY
RELAY_SIGNER_SECRET=REPLACE_AT_DEPLOY

ADMIN_API_KEYS=REPLACE_AT_DEPLOY
TENANT_API_KEYS=REPLACE_AT_DEPLOY

RATE_LIMIT_PER_MINUTE=60

PARTITION_RETENTION_MONTHS=12
PARTITION_MAINTENANCE_INTERVAL_SECONDS=86400

# Consumed only by scripts/db/init-roles.sh at first container boot — never
# read by the application itself. Must never be the same value across
# environments.
PULSAR_APP_PASSWORD=REPLACE_AT_DEPLOY
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_AT_DEPLOY
POSTGRES_DB=pulsar_core
